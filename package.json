{
  "name": "opensourcearras",
  "version": "1.0.0",
  "main": "server/index.js",
  "scripts": {
    "start": "node --max-old-space-size=350 --optimize-for-size server/index.js",
    "startOptimized": "node --max-old-space-size=350 --optimize-for-size --no-lazy --gc_interval=120 server/index.js",
    "restartOnSaveOptimized": "node --max-old-space-size=350 --optimize-for-size --no-lazy --gc_interval=120 --watch server/index.js",
    "startOriginal": "node server/index",
    "restartOnSave": "node --watch server/index",
    "host": "node standaloneClient/index",
    "build": "node standaloneClient/build minify"
  },
  "dependencies": {
    "ws": "^8.13.0"
  },
  "engines": {
    "node": "18.x"
  },
  "license": "GPL-3.0"
}